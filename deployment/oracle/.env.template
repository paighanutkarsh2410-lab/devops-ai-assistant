# ============================================
# ORACLE CLOUD BACKEND - Environment Variables
# Copy this to .env and fill in your values
# ============================================

# Database (auto-created by docker-compose)
DB_PASSWORD=__YOUR_STRONG_DB_PASSWORD__
DATABASE_URL=postgresql://devops_user:__YOUR_STRONG_DB_PASSWORD__@postgres:5432/devops_ai

# Redis (internal docker network)
REDIS_URL=redis://redis:6379

# JWT Secret (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=__YOUR_JWT_SECRET__

# Anthropic Claude API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=__YOUR_ANTHROPIC_KEY__

# Groq API Key (https://console.groq.com) - optional
GROQ_API_KEY=__YOUR_GROQ_KEY__

# CORS - your Vercel frontend URL
CORS_ORIGINS=__YOUR_VERCEL_URL__

# Grafana
GRAFANA_PASSWORD=__YOUR_GRAFANA_PASSWORD__

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
