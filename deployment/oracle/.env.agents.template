# ============================================
# AGENTS - Environment Variables
# Copy this to .env.agents and fill in values
# ============================================

# Backend URL (internal docker network)
BACKEND_URL=http://backend:8000
PROMETHEUS_URL=http://prometheus:9090

# Agent credentials (will be auto-registered on first run)
AGENT_EMAIL=agent@devops-ai.system
AGENT_PASSWORD=__YOUR_AGENT_PASSWORD__

# API Keys
ANTHROPIC_API_KEY=__YOUR_ANTHROPIC_KEY__
GROQ_API_KEY=__YOUR_GROQ_KEY__

# Redis
REDIS_URL=redis://redis:6379

# Monitor settings
CHECK_INTERVAL_SECONDS=30
ANOMALY_THRESHOLD=2.5
LOG_LEVEL=INFO

# Qdrant (optional - vector search for learning agent)
QDRANT_URL=__YOUR_QDRANT_URL__
QDRANT_API_KEY=__YOUR_QDRANT_KEY__

# Slack (optional - notifications)
SLACK_WEBHOOK_URL=__YOUR_SLACK_WEBHOOK__
SLACK_BOT_TOKEN=__YOUR_SLACK_TOKEN__
SLACK_CHANNEL=#all-devops-ai-assistant

# Email via Resend (optional)
RESEND_API_KEY=__YOUR_RESEND_KEY__
